#!name=Spotify Premium (local copy)
#!desc=Copy để nghiên cứu/làm theo: lấy từ https://yfamilys.com/module/spotifyVIP.module (devchristian1337). Đã tải JS về local và trỏ script-path nội bộ. Cần bật MITM + tin cậy CA Shadowrocket.
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Spotify.png
#!homepage=https://yfamilys.com
#!author=devchristian1337

[Rule]
AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,QUIC)),REJECT
DOMAIN,aet.spotify.com,REJECT

[URL Rewrite]
^https:\/\/(spclient\.wg|.*-spclient)\.spotify\.com(:443)?\/pendragon - reject-dict
^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/(?:ads\/|ad-logic\/|[^?#]*\/ad-on-app-open|premium-marketing\/upsellOffer) - reject

[Header Rewrite]
http-request ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize header-del 'if-none-match'
http-request ^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/(?:remote-config-resolver\/v\d+\/configuration|nebula\/v\d+\/configuration\/attributes)(?:\?[^#]*)?$ header-del 'if-none-match'

[Script]
Spotify gabo = type=http-request, pattern=^https:\/\/(.*-spclient\.spotify\.com(:443)?|spclient\.wg\.spotify\.com)\/gabo-receiver-service, script-path=spot-gabo.js, timeout=10
Spotify search ads = type=http-response, pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/browsita\/v.\/browse, script-path=spot-NoSearchAd.js, requires-body=true, binary-body-mode=true, timeout=10
Spotify home ads = type=http-response, pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/casita\/v.\/home\/, script-path=spot-NoHomeAd.js, requires-body=true, binary-body-mode=true, timeout=10
Spotify scroll ads = type=http-response, pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/scrollsita\/v.\/scroll\/spotify, script-path=spot-NoScrollAd.js, requires-body=true, binary-body-mode=true, timeout=10
# (Bản gốc có placeholder {{{spot_remote_config}}} ở dòng eevee và trùng pattern bootstrap/customize với ev3; giữ ev3 làm mặc định, eevee để tham khảo)
# Spotify protobuf (remote/eevee) = type=http-response, pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)(\?.*)?$, script-path=spot-proto-eevee.js, requires-body=true, binary-body-mode=true, timeout=10
Spotify protobuf (local) = type=http-response, pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)(\?.*)?$, script-path=spot-proto-ev3.js, requires-body=true, binary-body-mode=true, timeout=10
Spotify protobuf (app 9.1.98+ configuration and attributes) = type=http-response, pattern=^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/(?:remote-config-resolver\/v\d+\/configuration|nebula\/v\d+\/configuration\/attributes)(?:\?[^#]*)?$, script-path=spot-proto-ev3.js, requires-body=true, binary-body-mode=true, timeout=10

[MITM]
hostname = %APPEND% spclient.wg.spotify.com, *spclient.spotify.com
